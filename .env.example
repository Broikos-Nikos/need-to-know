# Copy to .env and fill in what you have. .env is ignored by git.
# Only DeepSeek is needed for the evaluated path; the other three are optional.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Where the corpus, caches, manifest and index live. Several GB at full size.
NTK_DATA_DIR=./data
