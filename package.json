    "check:page": "node tools/check-page.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "playwright": "1.61.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "fsevents": true
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
